<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 关闭可空标注：YuoCore.Ecs 的 API 未标注可空，GetComponent 返回 null 是正常路径 -->
    <Nullable>disable</Nullable>
    <AssemblyName>EcsDifferential</AssemblyName>
    <RootNamespace>DaoHua.EcsDifferential</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- 双内核切换：构建脚本显式传入绝对路径；默认值与仓库其它项目一致 -->
    <YuoCoreRoot Condition="'$(YuoCoreRoot)' == ''">../../vendor/YuoCore</YuoCoreRoot>
    <!-- 与 src/Ecs/Ecs.csproj 同一约定：ecs-optimized 变体打开 YUOCORE_OPTIMIZED，
         用于条件编译基线没有的 API（SetActiveEntities） -->
    <EcsBuildVariant Condition="'$(EcsBuildVariant)' == ''">current</EcsBuildVariant>
    <DefineConstants Condition="'$(EcsBuildVariant)' == 'ecs-optimized'">$(DefineConstants);YUOCORE_OPTIMIZED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(YuoCoreRoot)/src/YuoCore.Ecs/YuoCore.Ecs.csproj" />
  </ItemGroup>
</Project>
