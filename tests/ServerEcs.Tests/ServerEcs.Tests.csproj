<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- ecs-current 对照腿测试：直引项目的全局属性集必须与 ServerEcs 侧逐字一致，
         否则同一编译会话出现两套 Domain/Ecs 实例并行写同名输出目录。 -->
    <ProjectReference Include="../../src/Ecs/Ecs.csproj" AdditionalProperties="YuoCoreRoot=../../vendor/YuoCore;EcsBuildVariant=ecs-current" />
    <ProjectReference Include="../../src/ServerEcs/ServerEcs.csproj" />
    <ProjectReference Include="../../src/Server.Clean/Server.Clean.csproj" AdditionalProperties="YuoCoreRoot=../../vendor/YuoCore" />
    <ProjectReference Include="../../src/Domain/Domain.csproj" AdditionalProperties="YuoCoreRoot=../../vendor/YuoCore" />
    <ProjectReference Include="../../src/Protocol/Protocol.csproj" />
  </ItemGroup>
</Project>
