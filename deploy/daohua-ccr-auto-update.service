[Unit]
Description=道化太初 CCR 镜像更新检查
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Compose 插值使用 /opt/daohua/daohua.env 中的数据库和 ComputeNode 凭据。
EnvironmentFile=-/opt/daohua/daohua.env
ExecStart=/opt/daohua/ccr-auto-update.sh
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
