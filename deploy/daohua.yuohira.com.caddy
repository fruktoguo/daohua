daohua.yuohira.com {
	encode zstd gzip
	@backup_auth {
		path /internal/backups/*
		header X-Backup-Token "{$DAOHUA_BACKUP_TOKEN}"
	}
	handle @backup_auth {
		uri strip_prefix /internal/backups
		root * /opt/daohua/backups
		file_server browse
	}

	@backup_unauth path /internal/backups/*
	respond @backup_unauth 404


	@blocked path_regexp blocked (?i)((^|/)[.]|[.](php|sql|sqlite|db|bak|zip|tar|gz|key|pem)$)
	respond @blocked 404

	@probe path /actuator/* /wp-* /docker-compose* /config.xml
	respond @probe 404

	@private path /api/metrics /api/v1/metrics /api/v1/market/metrics /api/debug/* /readyz /ops /ops/*
	respond @private 404

	# 静态文件直出（隐私政策与最新客户端安装包）
	@static path /privacy /privacy.html /daohua.apk
	handle @static {
		root * /opt/daohua/static
		try_files {path} /privacy.html
		file_server
	}

	# Android HD 画质资源包（/hd/* → /opt/daohua/static/hd 符号链接，发布时原子切换）
	@hd path /hd/*
	handle @hd {
		uri strip_prefix /hd
		root * /opt/daohua/static/hd
		file_server
		header Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://daohua.yuohira.com https://img.yuohira.com https://daohua-emotes.fruktoyao.workers.dev; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy 127.0.0.1:15128 {
		health_uri /readyz
		health_interval 15s
		health_timeout 5s
	}
}
