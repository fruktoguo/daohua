{
  "name": "daohua-frontend",
  "private": true,
  "version": "0.3.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/build-simulator.mjs && node ../scripts/export-i18n-csv.mjs && vite",
    "build": "node ../scripts/build-simulator.mjs && node ../scripts/export-i18n-csv.mjs && tsc -b && vite build && node ../scripts/gen-asset-manifest.mjs dist",
    "simulator:build": "node ../scripts/build-simulator.mjs",
    "preview": "vite preview",
    "i18n:export": "node ../scripts/export-i18n-csv.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "validator": "^13.15.35",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.27.7",
    "javascript-obfuscator": "^5.9.0",
    "svgo": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.7"
  },
  "packageManager": "npm@11.6.2",
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.64.9"
  }
}
