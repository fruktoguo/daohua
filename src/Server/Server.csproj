<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Server</AssemblyName>
    <RootNamespace>Server</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- 前端由 Vite 构建后直接拷入 wwwroot（生产镜像见 Dockerfile），从不使用 SDK 静态资源管线。
         关闭它可避免残留清单崩溃：SDK 在 CreateBuilder 阶段就按 staticwebassets.runtime.json
         构造 PhysicalFileProvider，一旦该清单指向已删除的 wwwroot，进程会在 Program.cs 之前崩掉，
         代码里的目录守卫根本来不及生效。 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- 渐进式堆驻留：DATAS 自适应堆尺寸随真实负载伸缩，ConserveMemory=7 偏置小堆段勤收集，
         HeapCount=2 严格对齐 2c 生产宿主规格（Server GC 默认每逻辑核一堆，大内存开发机上成堆囤段的主因）。
         不设 HeapHardLimit 硬顶；768 MiB 工作集预算由容量门禁验收兜底。 -->
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="1" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="2" />
    <Compile Remove="Clean/**/*.cs" />
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Ecs/Ecs.csproj" />
    <ProjectReference Include="../Server.Clean/Server.Clean.csproj" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../config/game-data/*.json">
      <Link>config/game-data/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
