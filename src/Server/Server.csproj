<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Server</AssemblyName>
    <RootNamespace>Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主服 768 MiB 工作集预算内为 JIT、线程、连接与本机缓冲保留 256 MiB。 -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="536870912" />
    <Compile Remove="Clean/**/*.cs" />
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Ecs/Ecs.csproj" />
    <ProjectReference Include="../Server.Clean/Server.Clean.csproj" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../config/game-data/*.json">
      <Link>config/game-data/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
