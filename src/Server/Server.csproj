<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Server</AssemblyName>
    <RootNamespace>Server</RootNamespace>
    <IsPackable>false</IsPackable>
    <YuoCoreRoot Condition="'$(YuoCoreRoot)' == ''">../../vendor/YuoCore-optimized</YuoCoreRoot>
    <EcsBuildVariant Condition="'$(EcsBuildVariant)' == ''">ecs-optimized</EcsBuildVariant>
    <EcsIsolatedBuild Condition="'$(EcsIsolatedBuild)' == ''">true</EcsIsolatedBuild>
    <DefineConstants>$(DefineConstants);YUOCORE_OPTIMIZED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Clean/**/*.cs" />
    <EmbeddedResource Remove="Clean/Ops/OpsPage.html" />
    <!-- 引用边全局属性集必须全仓一致：同一项目若被不同全局集求值会生成多个实例
         并行写同一 bin 目录（同名程序集互相覆盖/文件锁冲突）。Domain 只认 YuoCoreRoot，
         Ecs 只认 YuoCoreRoot+EcsBuildVariant，其余变体属性为历史死属性勿再传递。 -->
    <ProjectReference Include="../Domain/Domain.csproj" AdditionalProperties="YuoCoreRoot=$(YuoCoreRoot)" />
    <ProjectReference Include="../Ecs/Ecs.csproj" AdditionalProperties="YuoCoreRoot=$(YuoCoreRoot);EcsBuildVariant=$(EcsBuildVariant)" />
    <ProjectReference Include="../Server.Clean/Server.Clean.csproj" AdditionalProperties="YuoCoreRoot=$(YuoCoreRoot)" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <Compile Include="../ServerEcs/Program.cs" Link="Program.cs" />
    <Compile Include="../ServerEcs/EcsPlayerRuntimeAdapter.cs" Link="EcsPlayerRuntimeAdapter.cs" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../config/game-data/*.json">
      <Link>config/game-data/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
