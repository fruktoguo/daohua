<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Server</AssemblyName>
    <RootNamespace>Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Abstractions/YuoCore.Abstractions.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Ecs/YuoCore.Ecs.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Persistence/YuoCore.Persistence.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Runtime/YuoCore.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../config/game-data/*.json">
      <Link>config/game-data/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本地运维面板页面：嵌入程序集，避免依赖 wwwroot（Development 下无静态站点根）。 -->
    <EmbeddedResource Include="Clean/Ops/OpsPage.html">
      <LogicalName>Server.Ops.OpsPage.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
