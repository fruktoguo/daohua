{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ops": {
    "Enabled": true,
    "Path": "/ops",
    "LogBufferCapacity": 500,
    "Token": "daohua-local-ops"
  },
  "Storage": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=daohua;Username=daohua;Password=daohua-local-dev;Maximum Pool Size=32;Minimum Pool Size=1;Timeout=5;Command Timeout=30;Keepalive=30",
    "EnableSchemaBootstrap": true,
    "SectionFlushBatchSize": 8192,
    "SectionFlushIntervalMilliseconds": 1000,
    "SectionFlushLeaseSeconds": 30,
    "OutboxBatchSize": 128,
    "OutboxPollIntervalMilliseconds": 1000,
    "RetentionBatchSize": 256,
    "DeliveredOutboxRetentionDays": 7,
    "SessionRetentionDays": 7,
    "AuditRetentionDays": 30,
    "AccountRiskEventRetentionDays": 30,
    "ComputeJobRetentionDays": 7,
    "DataProtectionKeyRetentionDays": 180
  },
  "GameData": {
    "Directory": "../../config/game-data"
  },
  "Market": {
    "PartitionCount": 1,
    "PartitionId": 0
  }
}
