{
  "AllowedHosts": "daohua.yuohira.com;localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "EnableSchemaBootstrap": false,
    "SectionFlushBatchSize": 256,
    "SectionFlushIntervalMilliseconds": 1000,
    "SectionFlushLeaseSeconds": 30,
    "OutboxBatchSize": 128,
    "OutboxPollIntervalMilliseconds": 1000,
    "RetentionBatchSize": 256,
    "DeliveredOutboxRetentionDays": 7,
    "SessionRetentionDays": 7,
    "AuditRetentionDays": 30,
    "ComputeJobRetentionDays": 7,
    "DataProtectionKeyRetentionDays": 180
  },
  "GameData": {
    "Directory": "config/game-data"
  },
  "Market": {
    "PartitionCount": 1,
    "PartitionId": 0
  },
  "AntiMultiOpen": {
    "TabGuardEnabled": true,
    "SingleSessionKickEnabled": true,
    "DeviceQuotaEnabled": false,
    "DeviceQuotaMaxAccounts": 2
  }
}
