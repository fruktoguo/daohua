{
  "AllowedHosts": "daohua.yuohira.com;localhost;127.0.0.1;app",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "EnableSchemaBootstrap": false,
    "SectionFlushBatchSize": 8192,
    "SectionFlushIntervalMilliseconds": 1000,
    "SectionFlushLeaseSeconds": 30,
    "OutboxBatchSize": 128,
    "OutboxPollIntervalMilliseconds": 1000,
    "RetentionBatchSize": 512,
    "RetentionIntervalSeconds": 300,
    "OnlineCheckpointIntervalSeconds": 600,
    "DeliveredOutboxRetentionDays": 7,
    "SessionRetentionDays": 7,
    "AuditRetentionDays": 30,
    "LedgerRetentionDays": 30,
    "TransientIdempotencyRetentionHours": 2,
    "AccountRiskEventRetentionDays": 30,
    "ComputeJobRetentionDays": 2,
    "DataProtectionKeyRetentionDays": 180,
    "SettlementClaimRetentionDays": 30
  },
  "GameData": {
    "Directory": "config/game-data"
  },
  "Market": {
    "PartitionCount": 1,
    "PartitionId": 0
  }
}
