<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DaoHua.ComputeNode</AssemblyName>
    <RootNamespace>DaoHua.ComputeNode</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- ComputeNode 是无状态、无数据库权限的冷挂机计算进程；不依赖 Domain、Server 或旧存档类型。 -->
  <ItemGroup>
    <Content Include="../../config/game-data/**/*.json">
      <Link>config/game-data/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
