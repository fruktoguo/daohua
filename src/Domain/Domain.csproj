<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Domain</AssemblyName>
    <RootNamespace>Domain</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      生产内核即优化版 YuoCore：所有未显式指定根目录的引用方统一落在 optimized。
      ecs-current 对照腿由 ServerEcs 经 AdditionalProperties 显式传入基线根目录。
    -->
    <YuoCoreRoot Condition="'$(YuoCoreRoot)' == ''">../../vendor/YuoCore-optimized</YuoCoreRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(YuoCoreRoot)/src/YuoCore.Abstractions/YuoCore.Abstractions.csproj" />
    <ProjectReference Include="$(YuoCoreRoot)/src/YuoCore.Ecs/YuoCore.Ecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 分段级回滚检查点等 internal API：仅供服务端单写者运行时与测试集访问，不构成第二套可变通道。 -->
    <InternalsVisibleTo Include="Server" />
    <InternalsVisibleTo Include="Server.Tests" />
    <InternalsVisibleTo Include="Domain.Tests" />
    <InternalsVisibleTo Include="DaoHua.Ecs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../config/game-data/**/*.json">
      <Link>Catalog/Defaults/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <LogicalName>Domain.Catalog.Defaults.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
