{
  "AllowedHosts": "xx.yuohira.com;localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "DurableOutboxEnabled": true,
    "DataDirectory": "/app/data",
    "OutboxDirectory": "/app/data/outbox",
    "PersistenceQueueCapacity": 65536
  },
  "GameData": {
    "Directory": "config/game-data"
  },
  "Market": {
    "LedgerProvider": "local-json",
    "PartitionCount": 1,
    "PartitionId": 0
  }
}
