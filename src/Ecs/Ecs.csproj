<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DaoHua.Ecs</RootNamespace>
    <AssemblyName>DaoHua.Ecs</AssemblyName>
    <!-- ECS-current/optimized 宿主通过此属性路由同名 YuoCore；生产默认即优化版，
         ecs-current 对照腿由 ServerEcs 显式传入基线根并带独立 obj/bin。 -->
    <YuoCoreRoot Condition="'$(YuoCoreRoot)' == ''">../../vendor/YuoCore-optimized</YuoCoreRoot>
    <EcsBuildVariant Condition="'$(EcsBuildVariant)' == ''">current</EcsBuildVariant>
    <DefineConstants Condition="'$(EcsBuildVariant)' == 'ecs-optimized'">$(DefineConstants);YUOCORE_OPTIMIZED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/Domain.csproj" AdditionalProperties="YuoCoreRoot=$(YuoCoreRoot)" />
    <ProjectReference Include="$(YuoCoreRoot)/src/YuoCore.Abstractions/YuoCore.Abstractions.csproj" />
    <ProjectReference Include="$(YuoCoreRoot)/src/YuoCore.Ecs/YuoCore.Ecs.csproj" />
    <ProjectReference Include="$(YuoCoreRoot)/src/YuoCore.Runtime/YuoCore.Runtime.csproj" />
  </ItemGroup>
</Project>
