<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Daoxuan.Server</AssemblyName>
    <RootNamespace>Daoxuan.Server</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Daoxuan.Domain/Daoxuan.Domain.csproj" />
    <ProjectReference Include="../Daoxuan.Protocol/Daoxuan.Protocol.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Persistence/YuoCore.Persistence.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Runtime/YuoCore.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../config/game-data/*.json">
      <Link>config/game-data/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
