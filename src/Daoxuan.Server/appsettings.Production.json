{
  "AllowedHosts": "xx.yuohira.com;localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "Provider": "postgres",
    "DurableOutboxEnabled": true,
    "PersistenceQueueCapacity": 65536,
    "EnableSchemaBootstrap": true
  },
  "GameData": {
    "Directory": "config/game-data"
  },
  "Market": {
    "LedgerProvider": "postgres",
    "PartitionCount": 1,
    "PartitionId": 0,
    "TradeRetentionDays": 14
  }
}
