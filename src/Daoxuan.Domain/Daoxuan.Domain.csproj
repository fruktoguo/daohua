<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Daoxuan.Domain</AssemblyName>
    <RootNamespace>Daoxuan.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Abstractions/YuoCore.Abstractions.csproj" />
    <ProjectReference Include="../../vendor/YuoCore/src/YuoCore.Ecs/YuoCore.Ecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../config/game-data/*.json">
      <Link>GameData/Defaults/%(Filename)%(Extension)</Link>
      <LogicalName>Daoxuan.Domain.GameData.Defaults.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
